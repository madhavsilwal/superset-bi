# Superset Engine Version
SUPERSET_VERSION=6.1.0

# Mandatory Cryptographic Secret (Generate with: openssl rand -base64 42)
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_42

# Local Metadata Database (PostgreSQL)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=superset
DATABASE_PASSWORD=superset
DATABASE_DB=superset

# Local Source / Analytics Database (PostgreSQL)
SOURCE_DB_NAME=analytics
SOURCE_DB_USER=analytics_user
SOURCE_DB_PASSWORD=analytics_password
SOURCE_DB_HOST_PORT=5433

# Redis Cache & Celery Broker
REDIS_HOST=redis
REDIS_PORT=6379

# Initial Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Admin
ADMIN_EMAIL=admin@example.com

# Ports
SUPERSET_PORT=8088
SUPERSET_HOST_PORT=8088

# Reverse Proxy / SSL Flags (Keep false locally; set true in production)
ENABLE_PROXY_FIX=false
SESSION_COOKIE_SECURE=false
PREFERRED_URL_SCHEME=http
